[Application]
name=com.kimi.Console
runtime=org.gnome.Platform/x86_64/50
sdk=org.gnome.Sdk/x86_64/50
command=kimi-console

[Context]
shared=network;ipc;
sockets=x11;wayland;pulseaudio;fallback-x11;
devices=dri;

[Extension com.kimi.Console.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=com.kimi.Console.Debug;