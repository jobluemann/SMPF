/* ===== Base ===== */
:root {
  --bg: #081426;
  --surface: #10233d;
  --surface-2: #173253;
  --text: #e8e8e8;
  --muted: #999;
  --accent: #4ea8de;
  --accent-2: #7ee787;
  --danger: #ff6b6b;
  --border: #333;
  --radius: 10px;
  --shadow: 0 4px 20px rgba(0,0,0,0.35);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--text); }
#app { display: flex; height: 100vh; overflow: hidden; }

/* ===== Sidebar ===== */
.sidebar { width: 220px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 18px 12px; }
.logo { font-weight: 700; font-size: 1.15rem; letter-spacing: .5px; padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 10px; }
.nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
.nav-btn { background: transparent; border: none; color: var(--muted); text-align: left; padding: 10px 12px; border-radius: var(--radius); cursor: pointer; font-size: .95rem; transition: .15s; }
.nav-btn:hover, .nav-btn.active { background: var(--surface-2); color: var(--text); }
.sync-status { margin-top: auto; font-size: .75rem; color: var(--muted); padding: 8px 12px; border-top: 1px solid var(--border); }

/* ===== Main ===== */
.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.view { display: flex; flex-direction: column; height: 100%; padding: 18px 22px; gap: 14px; }
.view.hidden { display: none; }
.view-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.view-header h2 { font-size: 1.25rem; }
.provider-select { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); border-radius: var(--radius); padding: 6px 10px; font-size: .9rem; }

/* ===== Chat ===== */
.chat-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 6px; }
.message { max-width: 82%; padding: 10px 14px; border-radius: var(--radius); font-size: .95rem; line-height: 1.45; word-wrap: break-word; }
.message.user { align-self: flex-end; background: var(--accent); color: #0f0f0f; }
.message.assistant { align-self: flex-start; background: var(--surface-2); }
.message .file-tag { display: inline-block; background: rgba(0,0,0,.25); padding: 2px 8px; border-radius: 6px; font-size: .78rem; margin-top: 6px; }
.chat-input-row { display: flex; gap: 8px; align-items: flex-end; }
.chat-input-row textarea { flex: 1; background: var(--surface-2); color: var(--text); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 12px; font-size: .95rem; resize: none; min-height: 44px; max-height: 160px; }
.icon-btn { background: var(--surface-2); border: 1px solid var(--border); color: var(--text); border-radius: var(--radius); width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; font-size: 1.1rem; }
.icon-btn:hover { background: var(--accent); color: #0f0f0f; }

/* ===== Toolbar & Lists ===== */
.toolbar { display: flex; gap: 8px; flex-wrap: wrap; }
.btn { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); border-radius: var(--radius); padding: 8px 14px; cursor: pointer; font-size: .9rem; transition: .15s; }
.btn:hover { background: var(--accent); color: #0f0f0f; border-color: var(--accent); }
.btn.danger:hover { background: var(--danger); color: #fff; border-color: var(--danger); }
.project-list, .prompt-list, .note-list, .context-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; overflow-y: auto; }

/* ===== Cards ===== */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; cursor: pointer; transition: .15s; }
.card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
.card h4 { font-size: 1rem; margin-bottom: 6px; }
.card p { font-size: .85rem; color: var(--muted); }
.card .actions { margin-top: 10px; display: flex; gap: 6px; }
.card .actions button { font-size: .78rem; padding: 4px 10px; }

/* ===== Forms ===== */
.form-row { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
.form-row label { font-size: .85rem; color: var(--muted); }
.form-row input, .form-row select, .form-row textarea { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); border-radius: var(--radius); padding: 8px 10px; font-size: .9rem; }
.form-row small { color: var(--muted); font-size: .75rem; }
.actions { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.log-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px; font-family: ui-monospace, SFMono-Regular, monospace; font-size: .8rem; color: var(--muted); white-space: pre-wrap; max-height: 200px; overflow-y: auto; }
.status-msg { font-size: .85rem; margin: 8px 0; min-height: 1.2em; }
.status-msg.ok { color: var(--accent-2); }
.status-msg.err { color: var(--danger); }

/* ===== Integration Tabs ===== */
.integration-tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
.tab-btn { background: transparent; border: none; color: var(--muted); padding: 10px 16px; cursor: pointer; font-size: .9rem; border-bottom: 2px solid transparent; }
.tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }
.tab-panel { display: none; }
.tab-panel.active { display: block; }
.hint { color: var(--muted); font-size: .85rem; margin-bottom: 12px; }
.post-list, .data-panel { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; margin-top: 12px; }

/* ===== Modals ===== */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: grid; place-items: center; z-index: 100; }
.modal { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; width: min(560px, 92vw); max-height: 86vh; overflow-y: auto; }
.modal h3 { margin-bottom: 12px; }

/* ===== Scrollbar ===== */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #444; }

/* ===== Voice ===== */
.icon-btn.listening { animation: mic-pulse 1s infinite; background: var(--danger); color: #fff; border-color: var(--danger); }
@keyframes mic-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
.message .msg-actions { display: flex; gap: 6px; margin-top: 8px; opacity: 0.6; transition: .15s; }
.message:hover .msg-actions { opacity: 1; }
.msg-actions button { background: transparent; border: 1px solid var(--border); color: var(--muted); border-radius: 6px; padding: 2px 8px; font-size: .75rem; cursor: pointer; }
.msg-actions button:hover { background: var(--accent); color: #0f0f0f; border-color: var(--accent); }
.voice-badge { display: inline-block; font-size: .7rem; color: var(--accent-2); margin-left: 6px; vertical-align: middle; }

/* ===== Light Theme ===== */
body.light {
  --bg: #f6f7f9;
  --surface: #fff;
  --surface-2: #f0f1f4;
  --text: #1a1a1a;
  --muted: #666;
  --border: #ddd;
}
body.light .message.assistant { background: #e9ecef; color: #1a1a1a; }
body.light .message.user { color: #fff; }
