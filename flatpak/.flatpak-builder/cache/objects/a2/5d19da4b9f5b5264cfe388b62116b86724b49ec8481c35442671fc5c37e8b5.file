{
  "id" : "com.kimi.Console",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "50",
  "runtime-commit" : "dec0fb025083b3543c1b1342360af86d5942fb2ac1358df3b8ac66168661b923",
  "sdk" : "org.gnome.Sdk",
  "sdk-commit" : "dfecff8363f84250df427a8998569ddade6ce9c5dc74f2ca4ceeeeaabe975985",
  "command" : "kimi-console",
  "modules" : [
    {
      "name" : "kimi-console",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "..",
          "type" : "dir"
        }
      ],
      "build-options" : {
        "env" : {
          "CFLAGS" : "-O2 -Wall"
        }
      },
      "build-commands" : [
        "cc $CFLAGS -o kimi-console flatpak/kimi-console.c $(pkg-config --cflags --libs gtk4 webkitgtk-6.0)",
        "install -Dm755 kimi-console /app/bin/kimi-console",
        "install -d /app/share/kimi-console",
        "cp -r index.html manifest.json sw.js css js /app/share/kimi-console/",
        "install -Dm644 flatpak/com.kimi.Console.desktop /app/share/applications/com.kimi.Console.desktop",
        "install -Dm644 flatpak/com.kimi.Console.svg /app/share/icons/hicolor/scalable/apps/com.kimi.Console.svg"
      ]
    }
  ],
  "finish-args" : [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--device=all",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "add-extensions" : {
    "org.freedesktop.Platform.ffmpeg-full" : {
      "directory" : "lib/ffmpeg",
      "add-ld-path" : ".",
      "version" : "24.08"
    }
  },
  "source-date-epoch" : 1787659306
}