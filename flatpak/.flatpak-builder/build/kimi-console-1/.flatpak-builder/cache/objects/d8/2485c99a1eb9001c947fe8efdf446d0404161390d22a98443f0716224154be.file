/**
 * Kimi Console — OpenClaw (MCP) Placeholder
 * Gated behind Moonshot API key. Disabled for free-tier-only users.
 */
class OpenClawClient {
  constructor(apiKey) {
    this.apiKey = apiKey;
    this.enabled = !!apiKey;
  }

  async test() {
    if (!this.enabled) return { ok: false, msg: 'OpenClaw requires a Moonshot API key. Add it in Integrations > OpenClaw.' };
    return { ok: true, msg: 'OpenClaw key saved. Full MCP integration pending.' };
  }
}
