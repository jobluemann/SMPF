{
  "name": "aiplatformfree-console",
  "version": "1.3.0",
  "description": "SMPF desktop app with chat, voice and AI integrations",
  "main": "main.js",
  "scripts": {
    "prepare-www": "rm -rf www && mkdir -p www && cp -r ../index.html ../manifest.json ../sw.js ../css ../js www/ && cp -r ../flatpak/com.aiplatformfree.Console.svg www/",
    "start": "npm run prepare-www && electron .",
    "build": "npm run prepare-www && electron-builder --linux dir"
  },
  "build": {
    "appId": "com.aiplatformfree.Console",
    "productName": "AIPLATFORMFREE",
    "executableName": "aiplatformfree-console",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "dir",
      "category": "Office"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
